{
  "name": "design-system-enforcer",
  "version": "1.4.0",
  "description": "MCP server, command line and Claude Code hooks that hold code to a project's own design system: its tokens, components and patterns",
  "type": "module",
  "main": "index.js",
  "bin": {
    "ds-enforcer": "bin/ds-enforcer.mjs"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node self-test.js && node --test test/*.test.mjs && node tests/run.mjs",
    "init": "node bin/ds-enforcer.mjs init",
    "sync": "node bin/ds-enforcer.mjs sync",
    "check": "node bin/ds-enforcer.mjs check"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "author": "Bill Bulman (https://workshopr.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbulman/design-system-enforcer.git"
  },
  "homepage": "https://github.com/bbulman/design-system-enforcer#readme",
  "bugs": {
    "url": "https://github.com/bbulman/design-system-enforcer/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "design-tokens",
    "claude",
    "claude-code",
    "tailwind",
    "shadcn",
    "lint",
    "accessibility",
    "figma",
    "swiftui"
  ],
  "files": [
    "*.js",
    "*.mjs",
    "!self-test.js",
    "bin/",
    "gate/",
    "init/",
    "data/",
    "hooks/",
    ".claude-plugin/",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
